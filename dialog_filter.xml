<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LỌC VÀ SẮP XẾP"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#F57C00"
        android:layout_marginBottom="16dp"/>

    <!-- SẮP XẾP -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sắp xếp theo:" android:textStyle="bold" android:textColor="#333333"/>
    <RadioGroup
        android:id="@+id/rgSort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <RadioButton android:id="@+id/rbNone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mặc định" android:checked="true"/>
        <RadioButton android:id="@+id/rbPriceAsc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Giá tăng dần"/>
        <RadioButton android:id="@+id/rbPriceDesc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Giá giảm dần"/>
        <RadioButton android:id="@+id/rbTimeAsc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thời gian chế biến tăng dần"/>
    </RadioGroup>

    <!-- LỌC THEO LOẠI MÓN -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lọc theo Loại món:" android:textStyle="bold" android:textColor="#333333"/>
    <Spinner
        android:id="@+id/spinnerFilterCategory"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@android:drawable/btn_dropdown"
        android:layout_marginBottom="12dp"/>

    <!-- LỌC THEO TRẠNG THÁI -->
    <CheckBox
        android:id="@+id/cbAvailableOnly"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chỉ hiển thị món đang bán"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="12dp"/>

    <!-- LỌC THEO KHOẢNG GIÁ -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Khoảng giá (VNĐ):" android:textStyle="bold" android:textColor="#333333"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp">

        <EditText
            android:id="@+id/edtMinPrice"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Từ..."
            android:inputType="numberDecimal"
            android:background="@android:drawable/editbox_background"
            android:paddingHorizontal="10dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" - " android:layout_marginHorizontal="8dp"/>

        <EditText
            android:id="@+id/edtMaxPrice"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Đến..."
            android:inputType="numberDecimal"
            android:background="@android:drawable/editbox_background"
            android:paddingHorizontal="10dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnApplyFilter"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Áp Dụng Tùy Chọn"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"/>

</LinearLayout>